
# Git files
.git/
.gitignore

# IDE files
.idea/
.vscode/

# Temporary files and logs
*.log
logs/
tmp/
*.tmp
*.swp

# Secrets and sensitive files
.env
.env.*
**/secrets/
**/*secret*
**/*credentials*
**/*.pem
**/*.key
**/*.p12
**/*.jks

# Files not needed to run the application
src/
.mvn/
mvnw
mvnw.cmd
pom.xml
README.md

# Exclude target contents except the Spring Boot JAR
target/*
!target/gestion-etudiants-0.0.1-SNAPSHOT.jar
